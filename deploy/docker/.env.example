# Copy to .env next to docker-compose.yml and edit. Every value has a default in the
# compose file; set only what differs.

# Bucket. With the bundled S3-compatible store keep the endpoint; for AWS S3 / R2 / GCS
# set the endpoint (or leave it empty for AWS), the region and real credentials, and
# drop the minio services from the compose file.
S3_BUCKET=valka
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ALLOW_HTTP=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Stable node id: a restart with the same id reclaims what the previous run left.
VALKA_NODE_ID=valka-1

RUST_LOG=valka=info,tower_http=info
